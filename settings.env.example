# OPTIONAL. Not needed for a normal installation - the app works with no settings file.
# To change something, copy this file to C:\ProgramData\LailaPayroll\settings.env and restart the PC
# (or: Task Scheduler > LailaPayroll > End, then Run).

# PORT=8585
# HTTPS_PORT=8443
# DEVICE_POLL_SECONDS=60
# BACKUP_KEEP_DAYS=30
# MOBILE_ENABLED=true
# MAX_GPS_ACCURACY_M=100

# Use SQL Server instead of the built-in database (create an empty database first):
# DATABASE_URL=mssql+pyodbc://payroll_user:PASSWORD@localhost/LailaPayroll?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
